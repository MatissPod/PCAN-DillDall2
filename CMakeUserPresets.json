{
  "version": 2,
  "configurePresets": [
    {
      "name": "windows",
      "inherits": "win",
      "environment": {
        "VCPKG_ROOT": "C:/Users/matis/vcpkg"
      }
    },
    {
      "name": "linux",
      "inherits": "lin",
      "environment": {
        "VCPKG_ROOT": "./vcpkg"
      }
    },
    {
      "name": "mac",
      "inherits": "lin",
      "environment": {
        "VCPKG_ROOT": "./vcpkg"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/usr/bin/clang",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++"
      }
    }
  ]
}